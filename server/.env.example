PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bluecollar
CLIENT_URL=http://localhost:5173

# Module 1 — auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Module 1 — uploads. Leave empty to store files in server/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Module 4 — first admin account created by `npm run seed:admin`
ADMIN_EMAIL=admin@seed.local
ADMIN_PASSWORD=admin123
